# =============================================================================
#  Docker 构建上下文忽略清单
#  目的：缩小构建上下文、防止敏感配置与运行时数据进入镜像。
# =============================================================================

# ===== 敏感配置（绝不进镜像）=====
.env
.env.*
!.env.example

# ===== 版本控制 / AI 工具环境 =====
.git
.gitattributes
.gitignore
.opencode/
.trellis/
.reasonix/
reasonix.toml
opencode.json
AGENTS.md

# ===== 构建产物 / 缓存 =====
target/
frontend/
node_modules/
.vite/
*.jar
*.war
*.class

# ===== 运行时数据（经 compose 挂卷，不打进镜像）=====
data/
logs/
*.log

# ===== 文档 / 原型（运行时不需要）=====
docs/
prototypes/

# ===== IDE / OS 杂项 =====
.idea/
.vscode/
.DS_Store
Thumbs.db
