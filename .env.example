# =============================================================================
#  Sparkora 环境变量模板
#  复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交真实凭据。
# =============================================================================

# =============================================================================
#  PostgreSQL
# =============================================================================

# 示例：localhost / 127.0.0.1 / postgres 容器名 / 内网 IP
SPARKORA_DB_HOST=localhost
SPARKORA_DB_PORT=5432
SPARKORA_DB_NAME=sparkora
SPARKORA_DB_USER=sparkora
SPARKORA_DB_PASSWORD=change-me

# 如果需要手动拼 JDBC URL，可使用下面格式；后续 Spring Boot 默认会优先用独立字段拼接。
# SPARKORA_DB_URL=jdbc:postgresql://${SPARKORA_DB_HOST}:${SPARKORA_DB_PORT}/${SPARKORA_DB_NAME}


# =============================================================================
#  搜索 / 抓取
# =============================================================================

SEARXNG_BASE_URL=http://localhost:5676
# Crawl4AI 抓取通道(10-05-crawl4ai-transport):无头浏览器,过指纹 WAF/渲染 SPA,B 级信源(乘联会)用。
# 未配置 base-url 时通道 configured()=false,调用方降级 HTTP 跳过(不影响 A 级源)。
# 资源红线:并发 ≤2、同 host ≤2/天(无头浏览器 300-400MB、本机 swap 偏紧),默认值不得放宽。
CRAWL4AI_BASE_URL=http://localhost:11235
CRAWL4AI_API_KEY=
CRAWL4AI_MAX_CONCURRENCY=2
CRAWL4AI_PER_HOST_DAILY_LIMIT=2
CRAWL4AI_TIMEOUT_MS=20000
# HTTP 通道同 host 相邻请求最小间隔(毫秒);无硬日上限(工信部一次公示含多条 BYD 子页可一轮采完)
SOURCE_HTTP_MIN_INTERVAL_MS=2000
SEARCH_TIMEOUT_MS=60000
CRAWL_TIMEOUT_MS=120000

# 通用信源采集基座(10-05-source-crawl-base)。总开关默认 false=零回归:
# 关闭时不注册任何动态调度、不发起采集;启用后按 sparkora_source 注册表逐源排期(全局串行)。
SOURCE_COLLECT_ENABLED=false
# 资源红线(无头浏览器 300-400MB、swap 偏紧):全局并发 ≤2、同站 ≤2/天。
SOURCE_MAX_CONCURRENCY=2
SOURCE_PER_SITE_DAILY_MAX=2


# =============================================================================
#  微信公众号草稿箱
# =============================================================================

WECHAT_MP_ENABLED=false
# 说明:WECHAT_APP_ID / WECHAT_APP_SECRET 供在「本机」直连微信发布时使用(如 wenyan CLI publish)。
# Sparkora 后端发布链路不经这两个变量:走 wenyan-server(方案 A),AppSecret 由 server 侧持有。
# 40125 invalid appsecret 即 server 侧凭据错误 → 到 wenyan-server 所在机器修 WECHAT_APP_SECRET 后重启 server。
WECHAT_APP_ID=change-me
WECHAT_APP_SECRET=change-me
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_TIMEOUT_MS=120000


# ============================================================================
#  模型配置（统一入口：本机 axonhub —— https://axo.caiqz.cn，OpenAI 兼容）
# ============================================================================

# 统一模型入口（文本生成 / 文生图均走此 baseURL）
# 注意(C1)：Spring AI 的 OpenAI SDK 只在该地址后追加 chat/completions（不带 /v1），
#   application.yml 已自动拼接 `${AI_BASE_URL}/v1` 命中网关 /v1/chat/completions。
#   如需覆盖整个地址（含 /v1），可另设 SPRING_AI_OPENAI_BASE_URL。
AI_BASE_URL=https://axo.caiqz.cn
AI_API_KEY=change-me
# 主模型（用于 brief/版本生成/改写/风格提炼）—— 填 axonhub 里的模型名
AI_MODEL=
# 向量化模型（S6 车型知识库 RAG；实测 Qwen3-Embedding-8B，1024 维）
AI_EMBEDDING_MODEL=Qwen3-Embedding-8B
# 向量维度（09-27：embedList 返回长度校验；默认 1024，与现向量表 DDL 一致。换模型须同步改向量表 DDL）
AI_EMBEDDING_DIM=1024
# 文生图（同样走 axonhub；接口：/v1/images/generations 文生图、/v1/images/edits 图生图）
# 图片模型不稳定，支持多个模型按顺序轮询：前一个失败自动切下一个。
# AI_IMAGE_MODELS 为逗号分隔；留空则回退到单数 AI_IMAGE_MODEL。
AI_IMAGE_MODEL=
AI_IMAGE_MODELS=

# 通用
AI_TIMEOUT_MS=120000
# 全局兜底温度(C1 前所有链路统一值;保留兼容旧配置与回退)
AI_TEMPERATURE=0.7
# C1 任务级温度(Spring AI ChatClient 收敛后按任务分流):
#   temperature-structured:结构化抽取(澄清研究计划/深度简报/子代理事实抽取/风格提炼/参数清洗/车型匹配),低温求稳定 JSON
#   temperature-prose     :正文创作(正文写作/多版本正文/仿写),高温求表达
#   temperature-qa        :知识问答,中温
AI_TEMPERATURE_STRUCTURED=0.2
AI_TEMPERATURE_PROSE=0.7
AI_TEMPERATURE_QA=0.5

# ============================================================================
#  图床(七牛云,S6:图库完全依赖图床,本地不留;图片入库即直接转存)
# ============================================================================

# 兼容旧裸名:AK / SK(不建议,建议改用 QINIU_ 前缀)
# AK=xxx
# SK=xxx
QINIU_ENABLED=true
QINIU_ACCESS_KEY=change-me
QINIU_SECRET_KEY=change-me
QINIU_BUCKET=caiqz
QINIU_UPLOAD_HOST=http://up-z2.qiniup.com
QINIU_PUBLIC_DOMAIN=http://pic.caiqz.cn
QINIU_TOKEN_TTL=3600

# ============================================================================
#  wenyan 集成(S4 预览 / S5 发布)
# ============================================================================

# 预览:本机 wenyan CLI(@wenyan-md/cli,与远程 server 同核渲染引擎,纯排版不碰微信)
WENYAN_CLI_PATH=wenyan
WENYAN_DEFAULT_THEME=default
# 已废弃(09-11-wenyan-themes):主题清单改由后端 WenyanThemeCatalog 权威目录固定(8 内置 + 7 社区),
# 本项不再参与校验/下发,配置与否不影响行为;保留仅为兼容旧部署。
WENYAN_THEME_NAMES=default,lapis,orangeheart,phycat
WENYAN_HIGHLIGHT=solarized-light
WENYAN_MAC_STYLE=true
WENYAN_FOOTNOTE=true
WENYAN_RENDER_TIMEOUT_MS=30000

# 发布(S5):远程 wenyan-server(公网部署,微信凭据配在 server 端)
# 实测 2.0.11:鉴权探针为 GET /verify(x-api-key;200 {"success":true} / 401 {"code":-1,"desc":...}),
#             POST /upload(multipart 字段名 file,限 md/css/json/图片,≤10MB)、POST /publish(JSON {fileId});
#             上传文件 TTL 10 分钟。早期版本对错误 key 有挂起行为,超时不宜过长。
# URL 需带协议前缀,如 http://10.126.126.1:3000
# (旧 stdio 模式的 WENYAN_MCP_ENABLED/WENYAN_MCP_BIN 在方案 A 下已废弃,配置与否不影响发布)
WENYAN_MCP_SERVER_URL=
WENYAN_MCP_SERVER_API_KEY=change-me
# 发布 HTTP 读超时(毫秒)
# 09-27 实测:带 7 张正文图(17MB)的 /publish 实耗 ~43s(拉图转存 + 微信写草稿),
# 30s 会「客户端超时但服务端已写入草稿」→ 前端报失败、草稿箱却已有文章,重试即产生重复草稿。
# 留足余量;调回 30s 以下会重现该事故。
# 注意:前端 axios 的 publish 超时必须 >= 本值(见 frontend/src/api/index.js,当前 300s)。
WENYAN_MCP_PUBLISH_TIMEOUT_MS=180000
# 探针读超时(毫秒),**必须独立于发布超时**:通道不可用时「发布参数」接口据此快速失败并禁用发布按钮。
# 两者曾共用一个客户端,调大发布超时会把探针一起调到 180s,导致发布页被挂住 3 分钟(09-27 事故二阶效应)。
# 探针纯只读、同机往返毫秒级,5s 足够;不加自动重试(通道真不可达时重试只会让等待翻倍)。
WENYAN_MCP_VERIFY_TIMEOUT_MS=5000

# ============================================================================
#  配图（S3b）
# ============================================================================

# 数据盘目录（S6 起图片不再落本地；仅 wenyan 渲染临时文件落位）
IMAGE_STORAGE_DIR=./data/images
# 上传大小上限（MB）
IMAGE_MAX_UPLOAD_MB=10
# multipart 请求体上限（MB）;09-26 图生图多参考图(≤4 张)需 >= 4×单张 + 表单开销
IMAGE_MAX_REQUEST_MB=45


# ============================================================================
#  JWT（Spring Security 登录会话）
# ============================================================================

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440


# ============================================================================
#  后端服务
# ============================================================================

SERVER_PORT=8080

# ============================================================================
#  Docker 产线部署（docker-compose.yml；本地热重载联调仍用 ./dev.sh）
# ============================================================================
#
# 端口关系：
#  - SERVER_PORT：后端容器内监听端口（上方），同时用作 compose 内网端口；
#                 compose 会把它传给前端容器，由 nginx 模板 envsubst 渲染
#                 `proxy_pass http://backend:<SERVER_PORT>`，无需手工同步 nginx 配置。
#  - BACKEND_PORT：后端映射到宿主机的端口（默认等于 SERVER_PORT，一般无需改）。
#  - FRONTEND_PORT：前端 nginx 映射到宿主机的访问端口（浏览器访问入口）。
#
# 改端口只改这里即可，无需改代码；docker compose up -d 生效。
# 启动：docker compose up -d --build   停止：docker compose down
# 详见 docs/deploy.md
BACKEND_PORT=8080
FRONTEND_PORT=8088

# ============================================================================
#  wenyan-server 发布通道(S5)正式配置见上方「wenyan 集成」区块;
#  旧 wenyan-mcp stdio 模式(ENABLED/BIN)在方案 A 下已废弃,如存在同名变量将被忽略。
# ============================================================================


# ============================================================================
#  车型知识库（S6：RAG）
# ============================================================================

# 数据源:比亚迪官网公开 JSON API(无鉴权)。一般无需改,除非官网接口变更。
CAR_GOODS_LIST_URL=https://cms-api.byd.com/car/byd/cn/goodsListForSearch
CAR_GOODS_INFO_URL=https://cms-api.byd.com/car/byd/cn/getGoodsInfoById
CAR_GOODS_PARAMS_URL=https://site-api.byd.com/domestic-official-api/goods/goodsParams
CAR_GOODS_ATTR_LIST_URL=https://cms-api.byd.com/car/byd/cn/getGoodsAttrListForCompareByGoodsId
# 采集 HTTP 读超时(毫秒)
CAR_TIMEOUT_MS=30000
# goodsParams 接口 HMAC 签名(官网前端 JS 硬编码;若官网变更需同步更新)
CAR_HMAC_SIGN_KEY=4a3688a5gcd88g443fga6b7fcb
CAR_HMAC_SECRET_KEY=fcb8f0ddg5c92g45b7g9d33g04cc55d3be3b
# 定时增量同步(C1):默认关闭,避免个人项目环境空跑;开启后按 cron 以官网目录全量幂等刷新
CAR_SYNC_ENABLED=false
CAR_SYNC_CRON=0 0 3 * * ?
# RAG 检索门槛(S6.1「必查+降级可见」):逐块相似度低于 AI_RAG_MIN_SCORE 的知识块不注入;
# 全部命中块的最高相似度低于 AI_RAG_REJECT_SCORE 时整体抛弃(生成继续,factRisks 标注数据缺失)。
# 默认 0.3 / 0.5 为粗调值,待按真实 query 分数分布校准;REJECT 须 >= MIN。
AI_RAG_MIN_SCORE=0.3
AI_RAG_REJECT_SCORE=0.5

# 通用知识库 KB(S7 车型库泛化):生成检索通用域注入块数上限(与车型域配额独立);
# AI_RAG_KB_ENABLED=false 一键回退 S6.2 纯车型域行为(异常回滚点)。
AI_RAG_KB_TOPK=4
AI_RAG_KB_ENABLED=true
# 生效期对账(10-03 E3):每日按当前日期重算 KB 向量 active(生效期到达/过期自动翻转,幂等)。一般无需改。
KB_EFFECTIVE_CRON=0 5 0 * * ?

# 统一检索(S8 去车型关联门禁):锚点车型块分数加权系数(关联车型=写作锚点,加权重排而非检索过滤)。
AI_RAG_ANCHOR_BOOST=1.15

# 图片语义检索(09-15 img-semantic-search 子B):图片向量用描述性文本代理嵌入(新闻标题+标签/AI prompt/文件名),
# 与 car/kb/news 三域同模型同维度(1024)同向量空间。低于该余弦相似度的图片命中被过滤(与 AI_RAG_MIN_SCORE 同口径)。
AI_IMAGE_MIN_SCORE=0.3

# 文章配图建议(09-15 article-auto-illustrate 子C):正文按段落锚点逐段语义检索图库,产出**建议**。
# 系统只产出建议,配图进入正文的唯一路径是用户在预览页显式点「采用」(无任何自动插入开关)。
# 锚点上限:单次建议最多取正文前 N 个可配图段落(纯列表/引用块/过短段落被跳过),避免配图过密。
AI_ILLUSTRATION_MAX_ANCHORS=5
# 每锚点候选图条数(逐锚点调用图片语义检索的 topK)。
AI_ILLUSTRATION_TOP_N=3
# 配图建议生成总开关(R6「可关闭」):false 时 suggest 直接返回「配图建议功能已关闭」、不产生建议、不调 embedding。
# 注意:关闭的只是「建议的生成」,与「禁止自动写入正文」是两件事——本项关闭后系统仍不会自动插入任何配图,
# 且**不存在**任何自动插入开关(无 AUTO_ILLUSTRATE_ENABLED 之类配置)。
AI_ILLUSTRATION_SUGGEST_ENABLED=true

# ============================================================================
#  新闻知识域（C2：比亚迪官方新闻 → 独立知识域 NEWS）
# ============================================================================

# 数据源:官方 CMS 列表接口(POST JSON) + www.byd.com 详情页 SSR HTML(jsoup 抽取正文)。一般无需改。
NEWS_LIST_URL=https://cms-api.byd.com/es/search
NEWS_DETAIL_BASE_URL=https://www.byd.com
# 采集 HTTP 读超时(毫秒)
NEWS_TIMEOUT_MS=30000
# 列表分页大小(实测 size=12,官网一页 12 条)
NEWS_PAGE_SIZE=12
# 定时增量同步(C2):默认关闭,避免个人项目环境空跑;开启后按 cron 抓取列表新条目(幂等 upsert)
NEWS_SYNC_ENABLED=false
NEWS_SYNC_CRON=0 30 3 * * ?
# 新闻域生成检索注入块数上限(与车型域/KB 配额独立;0=关闭 NEWS 注入,浏览/检索接口不受影响)
AI_RAG_NEWS_TOPK=4

# 通用信源(10-05 E):NEWS 域内用户采集源(sourceType=user-source)独立注入块数上限。
# 默认 0=关闭(零回归):BYD 官方新闻仍走 AI_RAG_NEWS_TOPK 不受影响;采集源默认不注入,须显式开启灰度。
AI_RAG_SOURCE_TOPK=0

# 检索重排(A 10-03-a-rerank):向量召回后、锚点加权/配额前插入一次 LLM 重排,提升相关性。
# 默认关闭(false),关闭时检索行为与现状逐条一致;开启后失败/超时/返回不可解析一律回退原序,绝不阻断生成。
# TOPN=参与重排的候选数上限(按原始相似度取前 N,控制 token);TIMEOUT_MS=单次超时预算(比 AI_TIMEOUT_MS 短)。
AI_RAG_RERANK_ENABLED=false
AI_RAG_RERANK_TOPN=20
AI_RAG_RERANK_TIMEOUT_MS=10000

# 深度生成模式(S9):研究子代理外部搜索开关与 Tavily/Serper 密钥。
# SEARXNG_BASE_URL 已在上方配置;首选源不可用时按策略自动降级后备源。
# 绑定路径:sparkora.deep.search-web-enabled / tavily-api-key / web-provider-order /
#          tavily-relay-api-base / tavily-relay-api-key /
#          serper-api-key / serper-api-base / serper-gl / serper-hl / web-vertical-news-enabled。
# 注意:密钥优先级 DEEP_* > 裸名(TAVILY_API_KEY / SERPER_API_KEY)。
SEARCH_WEB_ENABLED=true
TAVILY_API_KEY=
DEEP_TAVILY_API_KEY=
# Tavily 官方端点(URL 类配置一律 _BASE_URL 结尾,避免被 secret-guard 误判为凭据)。
# 10-05 起 DEEP_TAVILY_API_BASE_URL 改指「中转端点」(见下方),官方端点改由裸名 TAVILY_API_BASE_URL 覆盖。
TAVILY_API_BASE_URL=https://api.tavily.com
# Tavily 双端点(10-05-tavily-endpoint-priority):中转优先、官方兜底,两者 name() 同为 TAVILY(不升来源计数)。
# 中转端点默认空=未配置(不配则直接走官方,行为等价现状);配置后按 relay→official 顺序 failover。
# 密钥只放 .env;URL 键以 _BASE_URL 结尾。
DEEP_TAVILY_API_BASE_URL=
DEEP_TAVILY_API_KEY_HIKARI=
# 端点独立超时(ms):中转短超时(实测失败恒定约 16s,8s 快速失败后切官方)、官方较长;
# extract 独立超时(默认 15000),不被官方 search 的 30s 连带改变。
DEEP_TAVILY_RELAY_READ_TIMEOUT_MS=8000
DEEP_TAVILY_OFFICIAL_READ_TIMEOUT_MS=30000
DEEP_TAVILY_EXTRACT_READ_TIMEOUT_MS=15000
# 端点级质量门噪声域黑名单(逗号分隔,默认剔除已知跳转/聚合域);命中即视为无效并切官方。
DEEP_TAVILY_DENY_DOMAINS=weixin.sogou.com
# 结果级最低 content 长度(默认 0=off,零回归);>0 时低于阈值的命中丢弃,不注入。
DEEP_TAVILY_MIN_CONTENT_CHARS=0
# Serper(第二搜索源,Header X-API-KEY 认证,与 Tavily 的 body api_key 不同)。
# 未配置 SERPER_API_KEY 时 Serper 为 UNCONFIGURED,策略路由自动跳过,不影响 Tavily/SearxNG。
SERPER_API_KEY=
DEEP_SERPER_API_KEY=
# Serper 端点。官方 https://google.serper.dev;中转为 https://search.604020.xyz/serper
# (路径前缀 /serper 必须保留,故 URL 类配置以 _BASE_URL 结尾)。
SERPER_API_BASE_URL=
DEEP_SERPER_API_BASE_URL=https://google.serper.dev
# 地域本地化参数(默认中文,显著提升中文召回;空白则不下发该键)。
# 注意:若主用国际源,须覆盖为 gl=us / hl=en,否则 gl=cn 会成为错误约束。
DEEP_SERPER_GL=cn
DEEP_SERPER_HL=zh-cn
# 时效题是否走 Serper /news 垂直(默认 true;仅时效题触发,/news 与 /search 同价)。
# 关闭时所有问题强制 /search(web 垂直)——部署级零回归开关。
DEEP_WEB_VERTICAL_NEWS=true
# 外部搜索 provider 顺序(部署级默认;运行时全局策略由 ADMIN 在系统设置页覆盖,优先级更高):
# TAVILY,SEARXNG = TAVILY_FIRST(Tavily 优先、SearxNG 兜底,默认);SEARXNG,TAVILY = SEARXNG_FIRST;
# 含 SERPER 的顺序标签回落 PRIMARY_FANOUT。
# MVP 不支持 BOTH 双源聚合(不让付费 provider 无条件重复调用)。
DEEP_WEB_PROVIDER_ORDER=TAVILY,SEARXNG
# 多源并行聚合策略(10-04 B,默认关闭 = 零回归):
#   first_hit(默认)= 首个有效命中即停,行为与现状逐位等价;
#   primary_fanout = primary 组(order ∩ DEEP_WEB_PRIMARY_PROVIDERS)并行调用并跨源合并(去重/见证累加/统一 sourceId)。
# 运行时设置页不放开该开关(直接决定成本,误开即账单失控;预算治理见后续任务 C)。
DEEP_WEB_FANOUT=first_hit
# PRIMARY_FANOUT 的 primary 组(逗号分隔;默认 TAVILY,SERPER,SEARXNG:付费源互补交叉为主,
# 免费高召回的 SEARXNG 亦参与、配质量门后进合并池)。
# primary 为空或与 provider order 无交集 → 整体回落 first_hit(SearxNG-only 部署逐位不变)。
DEEP_WEB_PRIMARY_PROVIDERS=TAVILY,SERPER,SEARXNG
# SearXNG 结果质量门(仅对进 primary 组的 SearXNG 生效,不影响其他 provider):
# 域名黑名单默认剔除跳转聚合/视频噪声域;URL 含 /video/ 或 link?url= 的丢弃;空 title+content/非法 URL 丢弃。
DEEP_WEB_DENY_DOMAINS=bilibili.com,weixin.sogou.com
# 域名白名单(可空):命中者跳过黑名单与 URL 类型过滤(人工放行)。
DEEP_WEB_ALLOW_DOMAINS=
# 覆盖驱动多轮补检索 + 调用预算治理(10-04 C):
#   FOLLOWUP_MAX = Round 1 汇总后按缺口/低置信定向补搜的目标数上限;0=关闭多轮(默认,单轮研究零回归)。
#   CALL_BUDGET = 整个简报的「计量源」(付费 Tavily/Serper,免费 SearXNG 不计)调用总量上限,Round 1+Round 2 共享。
#   CALL_BUDGET_PER_ROUND = Round 1 阶段计量源调用次数封顶;生效值取 max(配置值, DEEP_MAX_AGENTS × |计量 primary|)
#     的保护性下限(默认配置 6×1=6 < 12,故生效 12),避免预算掐死主流程。
#   FOLLOWUP_TIMEOUT_MS = Round 2 单目标补检索独立超时;超时/异常记 warning 并跳过该目标,降级不阻断。
# 运行时设置页不放开这三项(直接决定成本,误开即账单失控)。
DEEP_WEB_FOLLOWUP_MAX=0
DEEP_WEB_CALL_BUDGET=20
DEEP_WEB_CALL_BUDGET_PER_ROUND=12
DEEP_FOLLOWUP_TIMEOUT_MS=30000
# 批次内搜索缓存 TTL(ms,默认 600000=10min):作用域严格限定单次 research 批次,随批次释放,不跨批次持久化。
DEEP_WEB_CACHE_TTL_MS=600000
# 研究子代理数量上限(护栏;默认 6):研究计划问题数超过时按前 N 条截断。
# 广度来自更多独立子代理,每 agent 的 WEB 检索预算随之摊薄(总预算约 8 条,webQuota=max(1,8/n))。
DEEP_MAX_AGENTS=6
# 背景题 WEB 正文补抓单条上限(字符,默认 2000):背景/来龙去脉型问题对 top 命中 URL 调
# Tavily /extract 取正文,工具层截断到该上限后注入研究上下文(参数题不补抓)。
# 仅背景题触发,量可控;抽取失败/空自动降级回摘要,不阻断研究。
DEEP_WEB_CONTENT_MAX_CHARS=2000
