# =============================================================================
#  Sparkora 环境变量模板
#  复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，切勿提交真实凭据。
# =============================================================================

# =============================================================================
#  PostgreSQL
# =============================================================================

# 示例：localhost / 127.0.0.1 / postgres 容器名 / 内网 IP
SPARKORA_DB_HOST=localhost
SPARKORA_DB_PORT=5432
SPARKORA_DB_NAME=sparkora
SPARKORA_DB_USER=sparkora
SPARKORA_DB_PASSWORD=change-me

# 如果需要手动拼 JDBC URL，可使用下面格式；后续 Spring Boot 默认会优先用独立字段拼接。
# SPARKORA_DB_URL=jdbc:postgresql://${SPARKORA_DB_HOST}:${SPARKORA_DB_PORT}/${SPARKORA_DB_NAME}


# =============================================================================
#  搜索 / 抓取
# =============================================================================

SEARXNG_BASE_URL=http://localhost:5676
CRAWL4AI_BASE_URL=http://localhost:11235
SEARCH_TIMEOUT_MS=60000
CRAWL_TIMEOUT_MS=120000


# =============================================================================
#  微信公众号草稿箱
# =============================================================================

WECHAT_MP_ENABLED=false
WECHAT_APP_ID=change-me
WECHAT_APP_SECRET=change-me
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WECHAT_TIMEOUT_MS=120000


# ============================================================================
#  模型配置（统一入口：本机 axonhub —— https://axo.caiqz.cn，OpenAI 兼容）
# ============================================================================

# 统一模型入口（文本生成 / 文生图均走此 baseURL）
AI_BASE_URL=https://axo.caiqz.cn
AI_API_KEY=change-me
# 主模型（用于 brief/版本生成/改写/风格提炼）—— 填 axonhub 里的模型名
AI_MODEL=
# 文生图（同样走 axonhub；接口：/v1/images/generations 文生图、/v1/images/edits 图生图）
# 图片模型不稳定，支持多个模型按顺序轮询：前一个失败自动切下一个。
# AI_IMAGE_MODELS 为逗号分隔；留空则回退到单数 AI_IMAGE_MODEL。
AI_IMAGE_MODEL=
AI_IMAGE_MODELS=

# 通用
AI_TIMEOUT_MS=120000
AI_TEMPERATURE=0.7


# ============================================================================
#  JWT（Spring Security 登录会话）
# ============================================================================

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440


# ============================================================================
#  后端服务
# ============================================================================

SERVER_PORT=8080


# ============================================================================
#  wenyan-mcp（预览 / 草稿发布；stdio 本地进程 或 Client-Server 模式）
# ============================================================================

WENYAN_MCP_ENABLED=false
WENYAN_MCP_BIN=wenyan-mcp   # 或 npx @wenyan-md/mcp
# Client-Server 模式（规避 IP 白名单）；留空则走本地 stdio
WENYAN_MCP_SERVER_URL=
WENYAN_MCP_SERVER_API_KEY=
