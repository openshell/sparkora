# Copy to config.env and fill in real values. Never commit config.env.
SPARKORA_BASE_URL=https://your-sparkora-server
# This must equal the server value of BYD_DYNASTY_AGENT_TOKEN.
SPARKORA_AGENT_TOKEN=replace-with-agent-token
# Stable local agent identity, for example: byd-dynasty-agent-thinkpad
SPARKORA_AGENT_ID=byd-dynasty-agent-local

# Directory containing wxa28c31d4ff7ae869 and wxa28c31d4ff7ae869.crc
BYD_DYNASTY_MMKV_DIR=C:\Users\<user>\AppData\Roaming\Tencent\xwechat\radium\users\<user-hash>\applet\local\wxa28c31d4ff7ae869\usrmmkvstorage0

BYD_DYNASTY_UPLOAD_URL=https://common-upload.bydauto.com/dynasty/App/ForUpload/upload
BYD_DYNASTY_UPLOAD_APP_KEY=clouduser
BYD_DYNASTY_UPLOAD_SIGN_KEY=replace-with-upload-sign-key
BYD_DYNASTY_UPLOAD_SESSION_ID=replace-with-session-id

# Legacy payload fallback only. These are BYD draft protocol fields (clubId/clubTitle),
# not a local circle catalog. Configure both or neither; payload v2 values take precedence.
BYD_DYNASTY_CLUB_ID=
BYD_DYNASTY_CLUB_TITLE=

# Local runtime
BYD_DYNASTY_BACKUP_DIR=
BYD_DYNASTY_MEDIA_TEMP_DIR=
BYD_DYNASTY_MAX_IMAGE_MB=20
BYD_DYNASTY_MAX_VIDEO_MB=300
BYD_DYNASTY_MIN_FREE_DISK_MB=200
BYD_DYNASTY_HEARTBEAT_INTERVAL_SECONDS=20
BYD_DYNASTY_POLL_INTERVAL_SECONDS=5
